# FlowForge Backend Environment Configuration
# Do not place actual secrets in this file.

# 'development' or 'production'
ENV=development

# The port the server will bind to
PORT=8080

# PostgreSQL connection string
DATABASE_URL=host=localhost dbname=flowforge_test user=postgres password=postgres port=5432

# The JWT signing secret. Must be securely generated in production.
# JWT_SECRET=your_super_secret_string_here

# Specific frontend origin allowed for CORS. Optional in dev, strictly recommended in production.
# CORS_ALLOWED_ORIGIN=https://flowforge.example.com
