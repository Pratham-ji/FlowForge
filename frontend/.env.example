# FlowForge Frontend Environment Configuration
# Do not place actual secrets in this file.

# The base URL for the FlowForge Backend API
# In development, this is typically proxied via Vite (e.g., left blank or '/api/v1')
# or pointed directly at the backend server.
# In production, this should point to the deployed backend URL.
VITE_API_BASE_URL=http://localhost:8080/api/v1
